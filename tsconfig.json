{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ecom/config": ["packages/shared-config/src"],
      "@ecom/logger": ["packages/shared-logger/src"]
    }
  },
  "include": ["services", "packages"]
}
